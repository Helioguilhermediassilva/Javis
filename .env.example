# =============================================================================
# JARVIS — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores antes de rodar
# `pnpm dev`. Nunca faça commit do .env.local.
# =============================================================================

# Chave da xAI (Grok). Necessária para chat, tool calling e sentiment.
# Obtenha em https://console.x.ai
XAI_API_KEY=

# Chave da ElevenLabs. Necessária para o TTS com a voz clonada do JARVIS.
# Obtenha em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# (Opcional) Gateway de LLM próprio. Quando omitido, o servidor chama
# a xAI diretamente com XAI_API_KEY.
LLM_API_URL=
LLM_API_KEY=

# =============================================================================
# TELEGRAM — webhook do Xavier
# Crie o bot pelo @BotFather e mantenha o token apenas no Vercel/.env.local.
# =============================================================================
TELEGRAM_BOT_TOKEN=
# Segredo definido ao registrar o webhook no Telegram.
TELEGRAM_WEBHOOK_SECRET=
# (Opcional) IDs de chat permitidos, separados por vírgula.
TELEGRAM_ALLOWED_CHAT_IDS=

# =============================================================================
# SUPABASE — autenticação e memória persistente do Xavier
# Projeto Cockpit_NowGo: https://jfeqkgdimjhbwaqmzxpu.supabase.co
# A chave pública pode ir para o frontend; a service_role/secret nunca pode ir para o navegador.
# =============================================================================
SUPABASE_URL=https://jfeqkgdimjhbwaqmzxpu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://jfeqkgdimjhbwaqmzxpu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Segredo privado para cifrar tokens Telegram por usuário no backend.
XAVIER_ENCRYPTION_KEY=
# URL pública do endpoint que recebe webhooks individuais.
XAVIER_TELEGRAM_WEBHOOK_BASE_URL=https://jarvisnowgo.com/api/telegram/webhook
