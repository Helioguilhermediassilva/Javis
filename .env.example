# =============================================================================
# JARVIS — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores antes de rodar
# `pnpm dev`. Nunca faça commit do .env.local.
# =============================================================================

# Chave da xAI (Grok). Necessária para chat, tool calling e sentiment.
# Obtenha em https://console.x.ai
XAI_API_KEY=

# Chave da ElevenLabs. Necessária para o TTS com a voz clonada do JARVIS.
# Obtenha em https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# =============================================================================
# RUNWAY — geração e edição de imagens, vídeos e referências visuais
# A chave REST deve existir somente no ambiente Production do Vercel.
# Crie em https://app.runwayml.com/settings/api-keys
# =============================================================================
RUNWAY_API_SECRET=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_IMAGE_MODEL=gen4_image
RUNWAY_VIDEO_MODEL=gen4.5
# RUNWAY_IMAGE_RATIO=1360:768
# RUNWAY_VIDEO_RATIO=1280:720
# RUNWAY_VIDEO_DURATION=5

# =============================================================================
# OPENROUTER — gateway LLM controlado para chat, visão e tools
# A chave deve existir somente no ambiente Production do Vercel.
# O Xavier mantém Claude direto para tarefas profundas/arquivos com recursos próprios.
# Catálogo: https://openrouter.ai/models
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.6-luna,moonshotai/kimi-k2.5
OPENROUTER_SITE_URL=https://jarvisnowgo.com
OPENROUTER_APP_NAME=Xavier - NowGo
# deny evita selecionar provedores que declarem coleta de dados quando suportado.
OPENROUTER_DATA_COLLECTION=deny

# =============================================================================
# CEREBRAS — rota rápida opcional para conversas textuais simples
# A chave deve existir somente no ambiente server-side do Vercel. Esta rota não usa
# tools, pesquisa, áudio, anexos, arquivos ou mídia; quando falha, o Xavier recua
# para Claude/OpenRouter. Use CEREBRAS_FAST_PATH_ENABLED=false para desligá-la sem
# remover a chave. A chave nunca deve ser exposta ao frontend, logs ou Git.
# Docs: https://inference-docs.cerebras.ai/resources/openai
# =============================================================================
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FAST_PATH_ENABLED=true
CEREBRAS_MAX_COMPLETION_TOKENS=512
CEREBRAS_TIMEOUT_MS=20000

# =============================================================================
# XAVIER CREDITS — política v3 configurável; valores comerciais não são preços Stripe
# Ajuste somente após validar custo real, impostos e margem. O custo do provedor
# permanece separado no ledger econômico interno.
# =============================================================================
XAVIER_CREDIT_ESTIMATE_VERSION=2026-08-22-3
XAVIER_CREDIT_DEFAULT_UNITS=2
XAVIER_CREDIT_LONG_TEXT_UNITS=2
XAVIER_CREDIT_DOCUMENT_UNITS=4
XAVIER_CREDIT_SPREADSHEET_UNITS=5
XAVIER_CREDIT_PRESENTATION_UNITS=8
XAVIER_CREDIT_PRESENTATION_VISUAL_BASE_UNITS=12
XAVIER_CREDIT_PRESENTATION_REFINEMENT_BASE_UNITS=2
XAVIER_CREDIT_PRESENTATION_IMAGE_UNITS=6
XAVIER_CREDIT_IMAGE_UNITS=8
XAVIER_CREDIT_VIDEO_FIRST_5_SECONDS=40
XAVIER_CREDIT_VIDEO_ADDITIONAL_5_SECONDS=25
# Ações externas/MCP continuam com a política anterior até revisão específica.
XAVIER_CREDIT_EXTERNAL_ACTION_UNITS=500

# (Opcional) Gateway de LLM legado. Usado apenas quando OPENROUTER_API_KEY estiver vazio.
LLM_API_URL=
LLM_API_KEY=

# =============================================================================
# TELEGRAM — webhook do Xavier
# Crie o bot pelo @BotFather e mantenha o token apenas no Vercel/.env.local.
# =============================================================================
TELEGRAM_BOT_TOKEN=
# Segredo definido ao registrar o webhook no Telegram.
TELEGRAM_WEBHOOK_SECRET=
# (Opcional) IDs de chat permitidos, separados por vírgula.
TELEGRAM_ALLOWED_CHAT_IDS=

# =============================================================================
# SUPABASE — autenticação e memória persistente do Xavier
# Projeto Cockpit_NowGo: https://jfeqkgdimjhbwaqmzxpu.supabase.co
# A chave pública pode ir para o frontend; a service_role/secret nunca pode ir para o navegador.
# =============================================================================
SUPABASE_URL=https://jfeqkgdimjhbwaqmzxpu.supabase.co
# Fluxos Web/provider-backed que precisarem persistir apresentações usam este bucket privado.
# Artefatos locais gerados e enviados pelo Telegram não usam Storage: são enviados por bytes e descartados após a entrega.
XAVIER_PRESENTATIONS_BUCKET=xavier-presentations
# Opcional: limite adicional somente para fluxos persistentes de apresentação. Deixe vazio/0 para não impor limite local.
XAVIER_PRESENTATION_APP_MAX_BYTES=0
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://jfeqkgdimjhbwaqmzxpu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Segredo privado para cifrar tokens Telegram por usuário no backend.
XAVIER_ENCRYPTION_KEY=
# URL pública do endpoint que recebe webhooks individuais.
XAVIER_TELEGRAM_WEBHOOK_BASE_URL=https://jarvisnowgo.com/api/telegram/webhook
